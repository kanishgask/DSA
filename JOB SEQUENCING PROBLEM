JOB SEQUENCING PROBLEM

(Greedy – NOT in your list)

🔹 Algorithm

Sort jobs by profit (descending)

Schedule job in latest free slot

🔹 Java Code
import java.util.*;

class Job {
    int id, profit, deadline;
    Job(int id, int d, int p) {
        this.id = id;
        this.deadline = d;
        this.profit = p;
    }
}

class JobSequencing {
    int[] schedule(Job[] jobs, int n) {
        Arrays.sort(jobs, (a, b) -> b.profit - a.profit);

        boolean[] slot = new boolean[n];
        int count = 0, profit = 0;

        for (Job job : jobs) {
            for (int j = Math.min(n, job.deadline) - 1; j >= 0; j--) {
                if (!slot[j]) {
                    slot[j] = true;
                    count++;
                    profit += job.profit;
                    break;
                }
            }
        }
        return new int[]{count, profit};
    }
}

