ALGORITHM
📌 Problem Statement

You are given an undirected, weighted graph with V vertices and E edges.
Each edge has a weight.

Your task is to find the Minimum Spanning Tree (MST) of the graph.

👉 Minimum Spanning Tree:

Connects all vertices

Contains exactly V - 1 edges

Has minimum possible total edge weight

💡 Key Idea (Kruskal’s Algorithm)

Sort all edges by increasing weight

Add edges one by one only if they don’t form a cycle

Use Disjoint Set Union (Union-Find) to detect cycles efficiently

🧠 Algorithm Steps

Sort all edges by weight

Initialize Disjoint Set (parent + rank)

For each edge (u, v, weight):

If find(u) != find(v)

Add edge to MST

Union the sets

Stop when MST contains V - 1 edges

⏱ Time & Space Complexity

Time: O(E log E) (sorting edges)

Space: O(V) (DSU arrays)

☕ Java Code (Kruskal’s Algorithm)
import java.util.*;

class Edge {
    int src, dest, weight;

    Edge(int s, int d, int w) {
        src = s;
        dest = d;
        weight = w;
    }
}

public class KruskalMST {

    static int[] parent;
    static int[] rank;

    // Find with path compression
    static int find(int x) {
        if (parent[x] != x)
            parent[x] = find(parent[x]);
        return parent[x];
    }

    // Union by rank
    static void union(int x, int y) {
        int rootX = find(x);
        int rootY = find(y);

        if (rootX != rootY) {
            if (rank[rootX] < rank[rootY])
                parent[rootX] = rootY;
            else if (rank[rootX] > rank[rootY])
                parent[rootY] = rootX;
            else {
                parent[rootY] = rootX;
                rank[rootX]++;
            }
        }
    }

    public static void main(String[] args) {

        int V = 4; // number of vertices

        ArrayList<Edge> edges = new ArrayList<>();
        edges.add(new Edge(0, 1, 10));
        edges.add(new Edge(0, 2, 6));
        edges.add(new Edge(0, 3, 5));
        edges.add(new Edge(1, 3, 15));
        edges.add(new Edge(2, 3, 4));

        // Step 1: Sort edges by weight
        edges.sort(Comparator.comparingInt(e -> e.weight));

        parent = new int[V];
        rank = new int[V];

        // Initialize DSU
        for (int i = 0; i < V; i++) {
            parent[i] = i;
            rank[i] = 0;
        }

        int mstWeight = 0;

        // Step 2: Pick edges
        for (Edge e : edges) {
            if (find(e.src) != find(e.dest)) {
                union(e.src, e.dest);
                mstWeight += e.weight;
                System.out.println(
                    e.src + " -- " + e.dest + " == " + e.weight
                );
            }
        }

        System.out.println("Total weight of MST: " + mstWeight);
    }
}

